 #include "uvcvideo.h"
 
+#define CREATE_TRACE_POINTS
+#include "uvc_trace.h"
+
+/* Unique per STREAMON within this module load; not userspace generation. */
+static atomic64_t edgevision_stream_ids = ATOMIC64_INIT(0);
+
+/* reason: 0=delivered to vb2, 1=internal corrupt-frame recycle, 2=cancel return. */
+static void edgevision_trace_buffer(struct uvc_video_queue *queue,
+				  struct uvc_buffer *buf, u32 reason)
+{
+	if (queue->queue.type == V4L2_BUF_TYPE_VIDEO_CAPTURE &&
+	    trace_uvc_frame_enabled()) {
+		struct uvc_streaming *stream = uvc_queue_to_stream(queue);
+
+		trace_uvc_frame(stream, buf, READ_ONCE(queue->edgevision_stream_id),
+				reason, ktime_get_ns());
+	}
+}
+
+/* action: 1=start attempt, 2=start failure, 3=stop, 4=disconnect cancel. */
+static void edgevision_trace_stream(struct uvc_video_queue *queue,
+				  u32 action, int result)
+{
+	if (queue->queue.type == V4L2_BUF_TYPE_VIDEO_CAPTURE &&
+	    trace_uvc_stream_enabled())
+		trace_uvc_stream(uvc_queue_to_stream(queue),
+			READ_ONCE(queue->edgevision_stream_id), action, result,
+			ktime_get_ns());
+}
+
